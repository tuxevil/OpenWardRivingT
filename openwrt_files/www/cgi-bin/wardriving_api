#!/bin/sh
ACTION=$(echo "$QUERY_STRING" | grep -o "action=[^&]*" | cut -d= -f2)

if [ "$ACTION" = "download_all" ]; then
    echo "Content-Type: application/gzip"
    echo "Content-Disposition: attachment; filename=\"openwardrivingt_captures_$(date +%Y%m%d_%H%M).tar.gz\""
    echo ""
    cd /mnt/wardriving && tar -czf - *.pcapng 2>/dev/null
    exit 0
fi

echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

if [ "$ACTION" = "status" ]; then
    IS_RUNNING=$(pgrep -f "wardriving_core.sh" >/dev/null && echo "true" || echo "false")
    FILES=$(ls -1 /mnt/wardriving/*.pcapng 2>/dev/null | wc -l)
    SPACE_FREE=$(df -h /mnt/wardriving | awk 'NR==2 {print $4}')
    GPS_STAT=$(netstat -an | grep 2947 | grep ESTABLISHED >/dev/null && echo "CONNECTED" || echo "WAITING")
    
    CLEAN_LOG=$(awk '/^[ \t]*[0-9]+ [0-9]{2}:[0-9]{2}:[0-9]{2}/ {chan=$1; time=$2; essid=$NF; if(length(essid)>2 && essid!~/:/ && essid !~ /^[0-9a-fA-F]{12}$/ && !seen[essid]++) print "[" time "] [CH " chan "] " essid}' /tmp/wardriving_status.log 2>/dev/null | tail -n 50)
    if [ -z "$CLEAN_LOG" ]; then
        LAST_LOG="Waiting for data or initializing monitor mode..."
    else
        LAST_LOG=$(echo "$CLEAN_LOG" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/$/\\n/g' | tr -d '\n')
    fi
    
    CHANNELS_JSON=$(awk '/^[ \t]*[0-9]+ [0-9]{2}:[0-9]{2}:[0-9]{2}/ {chan=$1; essid=$NF; if(length(essid)>2 && essid!~/:/ && essid !~ /^[0-9a-fA-F]{12}$/) print chan, essid}' /tmp/wardriving_status.log 2>/dev/null | sort -u | awk 'BEGIN{print "["} {if (NR>1) print ","; printf "{\"c\":%s, \"s\":\"%s\"}", $1, $2} END{print "]"}' | tr -d '\n')
    [ -z "$CHANNELS_JSON" ] && CHANNELS_JSON="[]"
    if [ "$CHANNELS_JSON" = "[]]" ]; then CHANNELS_JSON="[]"; fi
    
    cat << JSON
{
    "running": $IS_RUNNING,
    "files": "$FILES",
    "space_free": "$SPACE_FREE",
    "gps_status": "$GPS_STAT",
    "logs": "$LAST_LOG",
    "channels_data": $CHANNELS_JSON
}
JSON

elif [ "$ACTION" = "gps_push" ]; then
    NMEA_DATA=$(cat)
    if [ -n "$NMEA_DATA" ]; then
        echo "$NMEA_DATA" | socat - TCP4:127.0.0.1:2947 2>/dev/null
    fi
    echo '{"status": "ok"}'

elif [ "$ACTION" = "upload_tiles" ]; then
    cat > /tmp/tiles.tar.gz
    rm -rf /tmp/extract_tiles/
    mkdir -p /mnt/wardriving/tiles/ /tmp/extract_tiles/
    tar -xzf /tmp/tiles.tar.gz -C /tmp/extract_tiles/ 2>/dev/null
    
    Z_PARENT=$(find /tmp/extract_tiles/ -type d -name '[0-9]*' | head -n 1 | awk -F/ '{OFS="/"; NF--; print $0}')
    if [ -n "$Z_PARENT" ] && [ -d "$Z_PARENT" ]; then
        cp -r "$Z_PARENT"/* /mnt/wardriving/tiles/ 2>/dev/null
    else
        cp -r /tmp/extract_tiles/* /mnt/wardriving/tiles/ 2>/dev/null
    fi
    
    rm -rf /tmp/extract_tiles/ /tmp/tiles.tar.gz
    echo '{"status": "ok"}'

elif [ "$ACTION" = "map_data" ]; then
    LATEST_NMEA=$(ls -1t /mnt/wardriving/*.nmea 2>/dev/null | head -n 1)
    if [ -f "$LATEST_NMEA" ]; then
        BASENAME=$(basename "$LATEST_NMEA")
        echo "{\"nmea_url\": \"/wardriving/captures/$BASENAME\"}"
    else
        echo '{"nmea_url": ""}'
    fi

elif [ "$ACTION" = "start" ]; then
    /etc/init.d/wardriving start >/dev/null 2>&1
    echo '{"status": "started"}'
    
elif [ "$ACTION" = "stop" ]; then
    /etc/init.d/wardriving stop >/dev/null 2>&1
    echo '{"status": "stopped"}'

elif [ "$ACTION" = "list_files" ]; then
    awk 'BEGIN {print "["} {if (NR>1) print ","; gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); printf "\"%s\"", $0} END {print "\n]"}' /etc/wardriving_excluded.txt
    
elif [ "$ACTION" = "delete_file" ]; then
    FILE=$(echo "$QUERY_STRING" | grep -o "file=[^&]*" | cut -d= -f2)
    if [ -n "$FILE" ]; then
        FILE=$(echo "$FILE" | sed -e "s/[^a-zA-Z0-9._-]//g")
        rm -f "/mnt/wardriving/$FILE"
        rm -f "/mnt/wardriving/${FILE%.pcapng}.txt"
        rm -f "/mnt/wardriving/${FILE%.pcapng}.nmea"
        echo '{"status": "deleted"}'
    else
        echo '{"status": "error"}'
    fi
    
elif [ "$ACTION" = "get_hw" ]; then
    LEDS=$(ls -1 /sys/class/leds/ 2>/dev/null | awk 'BEGIN{printf "["} {if (NR>1) printf ","; printf "\"%s\"", $1} END{print "]"}')
    CUR_LED=$(grep "/sys/class/leds/" /etc/init.d/wardriving | head -n 1 | sed -n 's|.*/sys/class/leds/\([^/]*\)/.*|\1|p')
    [ -z "$CUR_LED" ] && CUR_LED="green:wps"
    CUR_BTN="none"
    if grep -q "wardriving_core" /etc/rc.button/wps 2>/dev/null; then CUR_BTN="wps"; fi
    if grep -q "wardriving_core" /etc/rc.button/rfkill 2>/dev/null; then CUR_BTN="wifi"; fi
    echo "{\"leds\": $LEDS, \"current_led\": \"$CUR_LED\", \"current_button\": \"$CUR_BTN\"}"

elif [ "$ACTION" = "set_hw" ]; then
    LED=$(echo "$QUERY_STRING" | grep -o "led=[^&]*" | cut -d= -f2 | sed 's/%3A/:/g')
    BTN=$(echo "$QUERY_STRING" | grep -o "btn=[^&]*" | cut -d= -f2)
    sed -i "s|/sys/class/leds/[^/]*/|/sys/class/leds/$LED/|g" /etc/init.d/wardriving
    cat << 'EOF_RESTORE' > /etc/rc.button/wps
#!/bin/sh
[ "$ACTION" = "pressed" ] && exit 5
for script in /etc/rc.wps/*; do
	[ -x "$script" ] || continue
	"$script" && break
done
EOF_RESTORE

    cat << 'EOF_RESTORE' > /etc/rc.button/rfkill
#!/bin/sh
[ "${ACTION}" = "released" -o -n "${TYPE}" ] || exit 0
. /lib/functions.sh
rfkill_state=0
wifi_rfkill_set() { uci set wireless.$1.disabled=$rfkill_state; }
wifi_rfkill_check() {
	local disabled; config_get disabled $1 disabled
	[ "$disabled" = "1" ] || rfkill_state=1
}
config_load wireless
case "${TYPE}" in
"switch") [ "${ACTION}" = "released" ] && rfkill_state=1 ;;
*) config_foreach wifi_rfkill_check wifi-device ;;
esac
config_foreach wifi_rfkill_set wifi-device
uci commit wireless; wifi up
return 0
EOF_RESTORE
    
    if [ "$BTN" = "wps" ]; then
        cat << 'EOF2' > /etc/rc.button/wps
#!/bin/sh
[ "${ACTION}" = "released" ] || exit 0
if pgrep -f "wardriving_core.sh" >/dev/null; then
    /etc/init.d/wardriving stop
else
    /etc/init.d/wardriving start
fi
EOF2
        chmod +x /etc/rc.button/wps
    elif [ "$BTN" = "wifi" ]; then
        cat << 'EOF2' > /etc/rc.button/rfkill
#!/bin/sh
[ "${ACTION}" = "released" ] || exit 0
if pgrep -f "wardriving_core.sh" >/dev/null; then
    /etc/init.d/wardriving stop
else
    /etc/init.d/wardriving start
fi
EOF2
        chmod +x /etc/rc.button/rfkill
    fi
    echo '{"status": "saved"}'
elif [ "$ACTION" = "get_exclusions" ]; then
    touch /etc/wardriving_excluded.txt /etc/wardriving_removed.txt
    cat /mnt/wardriving/*.txt 2>/dev/null | sort -u | awk 'FILENAME == ARGV[1] {rem[$0]; next} {if (!($0 in rem)) print $0}' /etc/wardriving_removed.txt - > /tmp/new_excl
    cat /etc/wardriving_excluded.txt >> /tmp/new_excl
    sort -u /tmp/new_excl > /etc/wardriving_excluded.txt
    rm -f /tmp/new_excl

    awk 'BEGIN {print "["} {if (NR>1) print ","; gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); printf "\"%s\"", $0} END {print "\n]"}' /etc/wardriving_excluded.txt

elif [ "$ACTION" = "add_exclusion" ]; then
    RAW_SSID=$(echo "$QUERY_STRING" | awk -F'ssid=' '{print $2}' | cut -d'&' -f1)
    SSID=$(echo "$RAW_SSID" | awk 'BEGIN{c2x["0"]="0";c2x["1"]="1";c2x["2"]="2";c2x["3"]="3";c2x["4"]="4";c2x["5"]="5";c2x["6"]="6";c2x["7"]="7";c2x["8"]="8";c2x["9"]="9";c2x["A"]="10";c2x["B"]="11";c2x["C"]="12";c2x["D"]="13";c2x["E"]="14";c2x["F"]="15";c2x["a"]="10";c2x["b"]="11";c2x["c"]="12";c2x["d"]="13";c2x["e"]="14";c2x["f"]="15"} {gsub(/\+/," "); res=""; i=1; while(i<=length($0)){c=substr($0,i,1); if(c=="%"){hex=substr($0,i+1,2); val=c2x[substr(hex,1,1)]*16+c2x[substr(hex,2,1)]; res=res sprintf("%c",val); i+=2} else{res=res c} i++} print res}')
    if [ -n "$SSID" ]; then
        touch /etc/wardriving_excluded.txt /etc/wardriving_removed.txt
        awk -v s="$SSID" '$0!=s' /etc/wardriving_removed.txt > /tmp/tmp_rm && mv /tmp/tmp_rm /etc/wardriving_removed.txt
        if ! grep -Fxq "$SSID" /etc/wardriving_excluded.txt; then
            echo "$SSID" >> /etc/wardriving_excluded.txt
        fi
        echo '{"status":"added"}'
    else
        echo '{"status":"error"}'
    fi

elif [ "$ACTION" = "remove_exclusion" ]; then
    RAW_SSID=$(echo "$QUERY_STRING" | awk -F'ssid=' '{print $2}' | cut -d'&' -f1)
    SSID=$(echo "$RAW_SSID" | awk 'BEGIN{c2x["0"]="0";c2x["1"]="1";c2x["2"]="2";c2x["3"]="3";c2x["4"]="4";c2x["5"]="5";c2x["6"]="6";c2x["7"]="7";c2x["8"]="8";c2x["9"]="9";c2x["A"]="10";c2x["B"]="11";c2x["C"]="12";c2x["D"]="13";c2x["E"]="14";c2x["F"]="15";c2x["a"]="10";c2x["b"]="11";c2x["c"]="12";c2x["d"]="13";c2x["e"]="14";c2x["f"]="15"} {gsub(/\+/," "); res=""; i=1; while(i<=length($0)){c=substr($0,i,1); if(c=="%"){hex=substr($0,i+1,2); val=c2x[substr(hex,1,1)]*16+c2x[substr(hex,2,1)]; res=res sprintf("%c",val); i+=2} else{res=res c} i++} print res}')
    if [ -n "$SSID" ]; then
        touch /etc/wardriving_excluded.txt /etc/wardriving_removed.txt
        awk -v s="$SSID" '$0!=s' /etc/wardriving_excluded.txt > /tmp/tmp_rm && mv /tmp/tmp_rm /etc/wardriving_excluded.txt
        if ! grep -Fxq "$SSID" /etc/wardriving_removed.txt; then
            echo "$SSID" >> /etc/wardriving_removed.txt
        fi
        echo '{"status":"removed"}'
    else
        echo '{"status":"error"}'
    fi

else
    echo '{"error": "unknown action"}'
fi
