#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034 # START/STOP used by OpenWrt rc.common framework

START=99
STOP=10

start() {
    logger -t "openwardrivingt" "Starting Wardriving Service"
    
    wifi down radio0
    sleep 1
    
    iw phy phy0 interface add wlan0mon type monitor 2>/dev/null
    ip link set wlan0mon up 2>/dev/null
    
    # SQLite Rotation / Vacuum
    if [ -f /mnt/wardriving/wardriving.db ]; then
        # Limit DB size by deleting networks older than 90 days if file is too big
        sqlite3 /mnt/wardriving/wardriving.db "DELETE FROM networks WHERE last_seen < datetime('now', '-90 days'); VACUUM;" 2>/dev/null
    fi
    
    /usr/bin/wardriving_core.sh >/tmp/wardriving_status.log 2>&1 &
    echo $! > /var/run/wardriving_core.pid
    
    # LED Blinking
    WPS_LED=$(ls /sys/class/leds/ | grep -i wps | head -n 1)
    if [ -n "$WPS_LED" ] && [ -d "/sys/class/leds/$WPS_LED" ]; then
        echo "timer" > /sys/class/leds/$WPS_LED/trigger
        echo 100 > /sys/class/leds/$WPS_LED/delay_on
        echo 100 > /sys/class/leds/$WPS_LED/delay_off
    fi
}

stop() {
    logger -t "openwardrivingt" "Stopping Wardriving Service"
    
    # Graceful shutdown: kill core script first, which traps and cleans children
    if [ -f /var/run/wardriving_core.pid ]; then
        PID=$(cat /var/run/wardriving_core.pid)
        kill -15 "$PID" 2>/dev/null
        sleep 2
        # Force if still alive
        kill -9 "$PID" 2>/dev/null
        rm -f /var/run/wardriving_core.pid
    fi
    
    # Cleanup any remaining wardriving processes by stored PID
    for pid in $(pgrep -f "wardriving_core.sh" 2>/dev/null); do
        [ "$pid" != "$$" ] && kill -15 "$pid" 2>/dev/null
    done
    sleep 1
    for pid in $(pgrep -f "wardriving_core.sh" 2>/dev/null); do
        [ "$pid" != "$$" ] && kill -9 "$pid" 2>/dev/null
    done
    
    # Only kill hcxdumptool instances that are children of wardriving
    for pid in $(pgrep -f "hcxdumptool.*wlan0mon" 2>/dev/null); do
        kill -15 "$pid" 2>/dev/null
    done
    sleep 1
    for pid in $(pgrep -f "hcxdumptool.*wlan0mon" 2>/dev/null); do
        kill -9 "$pid" 2>/dev/null
    done
    
    # Only kill the vGPS socat (listening on 2947)
    for pid in $(pgrep -f "socat.*vGPS" 2>/dev/null); do
        kill -15 "$pid" 2>/dev/null
    done
    
    sync
    
    ip link set wlan0mon down 2>/dev/null
    iw dev wlan0mon del 2>/dev/null
    
    wifi up radio0
    
    # LED Off
    WPS_LED=$(ls /sys/class/leds/ | grep -i wps | head -n 1)
    if [ -n "$WPS_LED" ] && [ -d "/sys/class/leds/$WPS_LED" ]; then
        echo "none" > /sys/class/leds/$WPS_LED/trigger
        echo 0 > /sys/class/leds/$WPS_LED/brightness
    fi
}
