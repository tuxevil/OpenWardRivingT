#!/bin/sh
# OpenWardRivingT commit-msg hook.
#
# Validates that the commit subject follows Conventional Commits.
# The release workflow (.github/workflows/release.yml) groups release notes
# by commit type, so out-of-spec messages break the auto-generated notes.
#
# Allowed types: feat fix docs security refactor perf test ci chore revert build
# Optional scope: <type>(<scope>): <subject>
# Subject rules:
#   - Non-empty, no leading/trailing whitespace.
#   - Lower-case imperative mood (no capital first letter unless proper noun).
#   - No trailing period.
#   - Subject + scope together ≤ 100 chars.
#   - First line of the message (the subject) ≤ 72 chars.
#
# Merge commits (created by `git merge` or the GitHub merge button) and
# revert commits produced by `git revert` are passed through unchanged.
#
# Pure POSIX sh. No bashisms.

set -eu

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=${2:-}

# Allow merge commits and squash plumbing to pass through unchanged. These
# are auto-generated by git, not user-typed.
case "$COMMIT_SOURCE" in
    merge|squash) exit 0 ;;
esac

# Read the first line (the subject).
SUBJECT=$(head -n 1 "$COMMIT_MSG_FILE" | tr -d '\r')

# Empty subject or comment line → not a regular commit; let Git handle it.
if [ -z "$SUBJECT" ] || [ "$(printf '%s' "$SUBJECT" | cut -c1)" = "#" ]; then
    exit 0
fi

# Revert commits: `git revert` produces "Revert "title of original commit"."
# Pass them through; the release workflow can still group them.
case "$SUBJECT" in
    Revert\ *) exit 0 ;;
esac

# Conventional commit regex: type[(scope)][!]: subject
# - type: [a-z]+ (no digits, no underscores)
# - scope: optional, anything without parens
# - !: optional breaking-change marker
# - subject: anything non-empty, no leading whitespace inside; first char
#   must be lowercase (proper nouns are allowed later in the subject).
#
# We match the *prefix* only (`type[(scope)][!]: `) and treat everything
# after that space as the subject. Type is then checked against an
# allowlist.
ALLOWED_TYPES='feat fix docs security refactor perf test ci chore revert build'

echo "$SUBJECT" | awk -v allowed="$ALLOWED_TYPES" '
BEGIN {
    n = split(allowed, a, " ")
    for (i = 1; i <= n; i++) allow[a[i]] = 1
}
{
    if (match($0, /^[a-z][a-z]*(\([^()]*\))?(!)?: /)) {
        type_start = RSTART
        type_len   = RLENGTH
        # Strip optional "(scope)" and "!" from the type length.
        # Simpler: copy the leading [a-z]+ run.
        if (match($0, /^[a-z][a-z]*/)) {
            type_str = substr($0, 1, RLENGTH)
        } else {
            type_str = ""
        }
        if (!(type_str in allow)) {
            print "unknown type: " type_str
            print "  allowed: " allowed
            exit 1
        }
        prefix_end = type_start + type_len - 1
        subject = substr($0, prefix_end + 1)
        sub(/^ +/, "", subject)
        if (subject == "") { print "subject is empty"; exit 1 }
        # First character of the subject must be lowercase or a digit.
        first = substr(subject, 1, 1)
        if (first ~ /[A-Z]/) {
            print "subject must start with a lowercase letter (use imperative mood)"
            exit 1
        }
        if (length($0) > 72) {
            print "first line is " length($0) " chars (max 72)"
            exit 1
        }
        if (length($0) > 100) {
            print "header is " length($0) " chars (max 100, per Conventional Commits)"
            exit 1
        }
        last = substr(subject, length(subject), 1)
        if (last == "." && length(subject) > 1) {
            print "subject must not end with a period"
            exit 1
        }
        exit 0
    }
    print "does not match Conventional Commits: <type>(<scope>)?: <subject>"
    print "  got: " $0
    print "  allowed types: " allowed
    exit 1
}' || {
    cat <<USAGE >&2

[!] Commit message does not follow Conventional Commits.

    <type>[(<scope>)]: <subject>

    <body>

    <footer>

Allowed types:
    feat       New user-visible feature
    fix        Bug fix
    docs       Documentation only
    security   Security fix or hardening
    refactor   Code change that neither fixes a bug nor adds a feature
    perf       Performance improvement
    test       Adding or fixing tests
    ci         CI, shellcheck, dependabot
    chore      Tooling, repo-meta, formatting
    revert     Revert a previous commit
    build      Build system or external dependencies

Examples:
    feat(dashboard): add device orientation to map overlay
    fix(handlers): URL-decode SSID before storing exclusion
    security(api): cap CONTENT_LENGTH on every endpoint
    docs(README): mention Authorization: Bearer header

See CONTRIBUTING.md for the full convention.
USAGE
    exit 1
}

exit 0
