        chmod +x "$TMP_BTN"
        mv "$TMP_BTN" /etc/rc.button/wps
        rm -f "$TMP_BTN"
    elif [ "$BTN" = "wifi" ]; then
        TMP_BTN=$(mktemp /tmp/wardriving_btn_XXXXXX)
        cat << 'EOF2' > "$TMP_BTN"
#!/bin/sh
[ "${ACTION}" = "released" ] || exit 0
if pgrep -f "wardriving_core.sh" >/dev/null; then
    /etc/init.d/wardriving stop
else
