#!/bin/sh
# ===== TOKEN EXTRACTION & AUTH CHECK =====
ACTION=$(echo "$QUERY_STRING" | grep -o "action=[^&]*" | cut -d= -f2)
TOKEN=$(echo "$QUERY_STRING" | grep -o "token=[^&]*" | cut -d= -f2)

# Actions that mutate state or expose sensitive data
case "$ACTION" in
    start|stop|delete_file|set_hw|set_processing|set_pcap_retention|save_wigle_token|wigle_upload|upload_tiles|upload_potfile|pwnagotchi_sync|add_target|remove_target|add_exclusion|remove_exclusion|download_all|download_bbox)
        if [ ! -f /etc/wardriving_api_token ] || [ "$TOKEN" != "$(cat /etc/wardriving_api_token)" ]; then
            echo "Content-Type: application/json"
            echo ""
            echo '{"error": "unauthorized", "reason": "valid token required for this action"}'
            exit 1
        fi
        ;;
esac

# ===== SHARED NMEA PARSER =====
# Usage: parse_nmea_rmc "$GPRMC_LINE"
# Outputs: lat lon speed_kmh date time
parse_nmea_rmc() {
    echo "$1" | awk -F',' '
    $1 ~ /^\$[A-Z]{2}RMC/ && $3 == "A" {
        # Parse lat: DDMM.MMMM
        lat_raw = $4; lat_dir = $5
        lat_deg = substr(lat_raw, 1, 2)
        lat_min = substr(lat_raw, 3)
        lat = lat_deg + (lat_min / 60)
        if (lat_dir == "S") lat = -lat
        
        # Parse lon: DDDMM.MMMM
        lon_raw = $6; lon_dir = $7
        lon_deg = substr(lon_raw, 1, 3)
        lon_min = substr(lon_raw, 4)
        lon = lon_deg + (lon_min / 60)
        if (lon_dir == "W") lon = -lon
        
        speed_kts = $8 + 0
        speed_kmh = speed_kts * 1.852
        
        date_raw = $10
        time_raw = $2
        
        printf "%.6f %.6f %.1f %s %s", lat, lon, speed_kmh, date_raw, time_raw
    }'
}

# ===== END PARSER =====

if [ "$ACTION" = "download_all" ]; then
    echo "Content-Type: application/gzip"
    echo "Content-Disposition: attachment; filename=\"openwardrivingt_captures_$(date +%Y%m%d_%H%M).tar.gz\""
    echo ""
    cd /mnt/wardriving && tar -czf - *.pcapng *.nmea *.hc2200 *.txt 2>/dev/null
    exit 0
fi


if [ "$ACTION" = "export_gpx" ]; then
    echo "Content-Type: application/gpx+xml"
    echo "Access-Control-Allow-Origin: *"
    echo "Content-Disposition: attachment; filename="wardriving_route_$(date +%Y%m%d_%H%M).gpx""
    echo ""
    cat /mnt/wardriving/*.nmea 2>/dev/null | awk '
    BEGIN {
        print "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
        print "<gpx version=\"1.0\">"
        print "  <trk><name>OpenWardRivingT Route</name><trkseg>"
    }
    # NMEA RMC parser — same formula as parse_nmea_rmc()
    /^\$[A-Z]{2}RMC/ {
        if($3 == "A") {
            lat_dec = substr($4,1,2) + (substr($4,3) / 60)
            if($5 == "S") lat_dec = -lat_dec
            lon_dec = substr($6,1,3) + (substr($6,4) / 60)
            if($7 == "W") lon_dec = -lon_dec
            t_raw = $2; d_raw = $10
            ts = "20" substr(d_raw,5,2) "-" substr(d_raw,3,2) "-" substr(d_raw,1,2) "T" substr(t_raw,1,2) ":" substr(t_raw,3,2) ":" substr(t_raw,5,2) "Z"
            printf "    <trkpt lat=\"%.6f\" lon=\"%.6f\">\n      <time>%s</time>\n    </trkpt>\n", lat_dec, lon_dec, ts
        }
    }
    END {
        print "  </trkseg></trk>"
        print "</gpx>"
    }'
    exit 0
fi

if [ "$ACTION" = "export_kml" ]; then
    echo "Content-Type: application/vnd.google-earth.kml+xml"
    echo "Access-Control-Allow-Origin: *"
    echo "Content-Disposition: attachment; filename="wardriving_route_$(date +%Y%m%d_%H%M).kml""
    echo ""
    cat /mnt/wardriving/*.nmea 2>/dev/null | awk '
    BEGIN {
        print "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
        print "<kml xmlns=\"http://www.opengis.net/kml/2.2\">"
        print "  <Document><name>OpenWardRivingT Route</name>"
        print "    <Placemark><name>Route</name><LineString>"
        print "      <tessellate>1</tessellate><coordinates>"
    }
    # NMEA RMC parser — same formula as parse_nmea_rmc()
    /^\$[A-Z]{2}RMC/ {
        if($3 == "A") {
            lat_dec = substr($4,1,2) + (substr($4,3) / 60)
            if($5 == "S") lat_dec = -lat_dec
            lon_dec = substr($6,1,3) + (substr($6,4) / 60)
            if($7 == "W") lon_dec = -lon_dec
            printf "        %.6f,%.6f,0\n", lon_dec, lat_dec
        }
    }
    END {
        print "      </coordinates>"
        print "    </LineString></Placemark>"
        print "  </Document>"
        print "</kml>"
    }'
    exit 0
fi

if [ "$ACTION" = "export_hashcat" ]; then
    echo "Content-Type: application/octet-stream"
    echo "Content-Disposition: attachment; filename=\"openwardrivingt_handshakes_$(date +%Y%m%d).hc2200\""
    echo ""
    cat /mnt/wardriving/master.hc2200 2>/dev/null
    exit 0
fi

echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

if [ "$ACTION" = "status" ]; then
    [ -f /var/run/wardriving_core.pid ] && kill -0 $(cat /var/run/wardriving_core.pid) 2>/dev/null && IS_RUNNING="true" || IS_RUNNING="false"
    HANDSHAKES=$(wc -l < /mnt/wardriving/master.hc2200 2>/dev/null || echo 0)
    read -r SPACE_USED SPACE_FREE USB_PCT <<_EOF
$(df -h /mnt/wardriving | awk 'NR==2 {print $3, $4, $5}' | tr -d '%')
_EOF
    read -r CPU_LOAD _ < /proc/loadavg
    read -r RAM_TOTAL RAM_USED <<_EOF
$(free -m | awk '/^Mem:/{print $2, $3}')
_EOF
    RAM_PCT=0; [ "$RAM_TOTAL" -gt 0 ] && RAM_PCT=$(( 100 * RAM_USED / RAM_TOTAL ))
    LATEST_NMEA=$(ls -1t /mnt/wardriving/*.nmea 2>/dev/null | head -n 1)
    SATS="0"
    DEAUTHS="N/A"
    FIX="0"
    if [ -f "$LATEST_NMEA" ]; then
        read -r FIX SATS SPEED <<_EOF
$(tail -n 30 "$LATEST_NMEA" | awk -F',' '/^\$G[PN]GGA/{f=$7; s=$8} /^\$[A-Z]{2}RMC/{sp=$8} END{print (f?f:0), (s?s:0), (sp?sp:0)}')
_EOF
    fi
    GPS_STAT="WAITING"
    if [ -f /tmp/vGPS_last ]; then
        LAST_MOD=$(date -r /tmp/vGPS_last +%s 2>/dev/null || echo 0)
        NOW=$(date +%s)
        if [ "$((NOW - LAST_MOD))" -lt 15 ]; then
            GPS_STAT="CONNECTED"
            read -r FIX SATS SPEED <<_EOF
$(awk -F',' '/^\$G[PN]GGA/{f=$7; s=$8} /^\$[A-Z]{2}RMC/{sp=$8} END{print (f?f:0), (s?s:0), (sp?sp:0)}' /tmp/vGPS_last 2>/dev/null)
_EOF
        fi
    fi
    
    LOG_DATA=$(tail -n 1000 /tmp/wardriving_status.log 2>/dev/null | tr -cd '\11\12\40-\176')
    CLEAN_LOG=$(echo "$LOG_DATA" | awk '/CHA   LAST/{buf=""} {buf = buf $0 "\n"} END{print buf}' | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | tr -cd '\11\12\40-\176')
    [ -z "$CLEAN_LOG" ] && CLEAN_LOG=$(echo "$LOG_DATA" | tail -n 30 | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | tr -cd '\11\12\40-\176')
    if [ -z "$CLEAN_LOG" ]; then
        LAST_LOG="Waiting for data or initializing monitor mode..."
    else
        LAST_LOG=$(echo "$CLEAN_LOG" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/$/\\n/g' | tr -d '\n')
    fi
    
    CHANNELS_JSON=$(echo "$LOG_DATA" | awk '/^[ \t]*[0-9]+ [0-9]{2}:[0-9]{2}:[0-9]{2}/ {chan=$1; essid=$NF; if(length(essid)>2 && essid!~/:/ && essid !~ /^[0-9a-fA-F]{12}$/){ k=chan"\t"essid; if(!seen[k]++){ if(!f) printf "["; else printf ","; printf "{\"c\":%s, \"s\":\"%s\"}", chan, essid; f=1 } }} END{if(!f) printf "["; print "]"}')
    [ -z "$CHANNELS_JSON" ] && CHANNELS_JSON="[]"
    if [ "$CHANNELS_JSON" = "[]]" ]; then CHANNELS_JSON="[]"; fi
    
    cat << JSON
{
    "running": $IS_RUNNING,
    "handshakes": "$HANDSHAKES",
    "space_used": "$SPACE_USED",
    "usb_pct": "$USB_PCT",
    "cpu": "$CPU_LOAD",
    "ram": "$RAM_PCT",
    "sats": "$SATS",
    "speed": "$SPEED",
    "deauths": "$DEAUTHS",
    "fix": "$FIX",
    "space_free": "$SPACE_FREE",
    "gps_status": "$GPS_STAT",
    "logs": "$LAST_LOG",
    "channels_data": $CHANNELS_JSON
}
JSON

elif [ "$ACTION" = "gps_push" ]; then
    NMEA_DATA=$(cat)
    if [ -n "$NMEA_DATA" ]; then
        # Basic NMEA validation: must start with $ and contain checksum
        case "$NMEA_DATA" in
            \$G*\**)
                if [ -p /tmp/vGPS_fifo ]; then printf "%s\n" "$NMEA_DATA" >> /tmp/vGPS_fifo; fi
                printf "%s\n" "$NMEA_DATA" > /tmp/vGPS_last
                ;;
            *)
                echo '{"status": "error", "reason": "invalid NMEA format"}'
                exit 0
                ;;
        esac
    fi
    echo '{"status": "ok"}'


elif [ "$ACTION" = "upload_potfile" ]; then
    # Limit upload to 1MB to prevent USB fill attacks
    dd bs=1k count=1024 of=/mnt/wardriving/hashcat.potfile 2>/dev/null
    echo '{"status": "ok"}'

elif [ "$ACTION" = "pwnagotchi_sync" ]; then
    # Pwnagotchi Bridge: receive .pcap from pwnagotchi, extract PMKIDs, merge into master
    if [ "$REQUEST_METHOD" != "POST" ]; then
        echo '{"error": "POST required"}'
        exit 0
    fi
    TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    PCAP_IN="/tmp/pwnagotchi_${TIMESTAMP}.pcap"
    HC2200_OUT="/tmp/pwnagotchi_${TIMESTAMP}.hc2200"
    ESSID_OUT="/tmp/pwnagotchi_${TIMESTAMP}.essid"
    
    # Save uploaded pcap
    cat > "$PCAP_IN"
    
    if [ -s "$PCAP_IN" ]; then
        # Extract PMKIDs and ESSIDs
        hcxpcapngtool -o "$HC2200_OUT" -E "$ESSID_OUT" "$PCAP_IN" > /dev/null 2>&1
        
        HAS_HASHES=0
        if [ -s "$HC2200_OUT" ]; then
            cat "$HC2200_OUT" >> /mnt/wardriving/master.hc2200
            sort -u /mnt/wardriving/master.hc2200 -o /mnt/wardriving/master.hc2200
            HAS_HASHES=$(wc -l < "$HC2200_OUT")
        fi
        
        HAS_ESSIDS=0
        if [ -s "$ESSID_OUT" ]; then
            cat "$ESSID_OUT" >> /mnt/wardriving/master_essid.txt
            sort -u /mnt/wardriving/master_essid.txt -o /mnt/wardriving/master_essid.txt
            HAS_ESSIDS=$(wc -l < "$ESSID_OUT")
        fi
        
        # Cleanup
        rm -f "$PCAP_IN" "$HC2200_OUT" "$ESSID_OUT"
        echo "{\"status\": \"ok\", \"hashes_added\": $HAS_HASHES, \"essids_added\": $HAS_ESSIDS}"
    else
        rm -f "$PCAP_IN"
        echo '{"status": "error", "reason": "empty upload"}'
    fi

elif [ "$ACTION" = "cracked_networks" ]; then
    echo "["
    if [ -f /mnt/wardriving/hashcat.potfile ] && [ -f /mnt/wardriving/wardriving.db ]; then
        awk -F'*' '/^WPA\*/ {print $4}' /mnt/wardriving/hashcat.potfile | sed 's/../&:/g; s/:$//' | tr 'a-z' 'A-Z' | sort -u > /tmp/cracked_macs.txt
        
        # Generar SQL para extraer lat, lon y ssid de esas MACs
        if [ -s /tmp/cracked_macs.txt ]; then
            COND=$(awk '{printf "\"%s\",", $1}' /tmp/cracked_macs.txt | sed 's/,$//')
            sqlite3 -separator '|' /mnt/wardriving/wardriving.db "SELECT lat, lon, ssid FROM networks WHERE mac IN ($COND) AND lat IS NOT NULL;" 2>/dev/null | awk -F'|' '
            BEGIN { first=1 }
            {
                if(!first) printf ","
                ssid=$3; gsub(/\\/, "\\\\", ssid); gsub("\x22", "\\\"", ssid);
                printf "{\"lat\":%s, \"lon\":%s, \"ssid\":\"%s\"}", $1, $2, ssid
                first=0
            }'
        fi
    fi
    echo "]"
    exit 0

elif [ "$ACTION" = "upload_tiles" ]; then
    cat > /tmp/tiles.tar.gz
    rm -rf /tmp/extract_tiles/
    mkdir -p /mnt/wardriving/tiles/ /tmp/extract_tiles/
    tar -xzf /tmp/tiles.tar.gz -C /tmp/extract_tiles/ 2>/dev/null
    
    Z_PARENT=$(find /tmp/extract_tiles/ -type d -name '[0-9]*' | head -n 1 | awk -F/ '{OFS="/"; NF--; print $0}')
    if [ -n "$Z_PARENT" ] && [ -d "$Z_PARENT" ]; then
        cp -r "$Z_PARENT"/* /mnt/wardriving/tiles/ 2>/dev/null
    else
        cp -r /tmp/extract_tiles/* /mnt/wardriving/tiles/ 2>/dev/null
    fi
    
    rm -rf /tmp/extract_tiles/ /tmp/tiles.tar.gz
    echo '{"status": "ok"}'


elif [ "$ACTION" = "save_wigle_token" ]; then
    if [ "$REQUEST_METHOD" = "POST" ]; then
        cat > /etc/wardriving_wigle_token
        chmod 600 /etc/wardriving_wigle_token
        echo '{"status": "ok"}'
    else
        echo '{"error": "POST required"}'
    fi

elif [ "$ACTION" = "wigle_upload" ]; then
    if [ ! -f "/etc/wardriving_wigle_token" ]; then
        echo '{"success": false, "error": "No WiGLE token configured. Save your API token first."}'
        exit 0
    fi
    if [ ! -f "/mnt/wardriving/wardriving.db" ]; then
        echo '{"success": false, "error": "No database found"}'
        exit 0
    fi
    TOKEN=$(cat /etc/wardriving_wigle_token)
    
    echo "WigleWifi-1.4,appRelease=1.0,model=OpenWardRivingT,release=1.0,device=OpenWrt,display=OpenWrt,board=OpenWrt,brand=OpenWrt" > /tmp/wigle.csv
    echo "MAC,SSID,AuthMode,FirstSeen,Channel,RSSI,CurrentLatitude,CurrentLongitude,AltitudeMeters,AccuracyMeters,Type" >> /tmp/wigle.csv
    sqlite3 -separator ',' /mnt/wardriving/wardriving.db "SELECT mac, ssid, enc, first_seen, channel, rssi, lat, lon, 0, 10, 'WIFI' FROM networks WHERE lat IS NOT NULL AND lat != 'NULL';" >> /tmp/wigle.csv
    
    RES=$(curl -s -m 30 -X POST "https://api.wigle.net/api/v2/network/upload" -H "Authorization: Basic $TOKEN" -H "Accept: application/json" -F "file=@/tmp/wigle.csv")
    rm -f /tmp/wigle.csv
    
    if echo "$RES" | grep -q '"success":true'; then
        echo '{"success": true}'
    else
        ERR=$(echo "$RES" | tr -d '\n' | sed 's/"/\\"/g')
        echo "{\"success\": false, \"error\": \"WiGLE rejected: $ERR\"}"
    fi
    exit 0


elif [ "$ACTION" = "heatmap_data" ]; then
    if [ -f /mnt/wardriving/wardriving.db ]; then
        sqlite3 -separator ',' /mnt/wardriving/wardriving.db "SELECT lat, lon, rssi FROM networks WHERE lat IS NOT NULL;" 2>/dev/null | awk -F',' '
        BEGIN { printf "[" }
        {
            if (NR>1) printf ",";
            intensity = ($3 + 100) / 60;
            if (intensity < 0) intensity = 0.1;
            if (intensity > 1) intensity = 1.0;
            printf "[%s, %s, %.2f]", $1, $2, intensity
        }
        END { print "]" }'
    else
        echo "[]"
    fi

elif [ "$ACTION" = "map_data" ]; then
    LATEST_NMEA=$(ls -1t /mnt/wardriving/*.nmea 2>/dev/null | head -n 1)
    if [ -f "$LATEST_NMEA" ]; then
        NMEA_B64=$(tail -n 20 "$LATEST_NMEA" | base64 | tr -d '\n')
        echo "{\"nmea_b64\": \"$NMEA_B64\"}"
    else
        echo '{"nmea_b64": ""}'
    fi


elif [ "$ACTION" = "download_status" ]; then
    if [ -f /tmp/dl_status.txt ]; then
        STAT=$(cat /tmp/dl_status.txt)
        echo "{\"status\": \"$STAT\"}"
    else
        echo '{"status": "NONE"}'
    fi

elif [ "$ACTION" = "download_bbox" ]; then
    N=$(echo "$QUERY_STRING" | grep -o "n=[^&]*" | cut -d= -f2 | tr -cd '0-9.-')
    S=$(echo "$QUERY_STRING" | grep -o "s=[^&]*" | cut -d= -f2 | tr -cd '0-9.-')
    E=$(echo "$QUERY_STRING" | grep -o "e=[^&]*" | cut -d= -f2 | tr -cd '0-9.-')
    W=$(echo "$QUERY_STRING" | grep -o "w=[^&]*" | cut -d= -f2 | tr -cd '0-9.-')
    ZMIN=$(echo "$QUERY_STRING" | grep -o "z1=[^&]*" | cut -d= -f2 | tr -cd '0-9')
    ZMAX=$(echo "$QUERY_STRING" | grep -o "z2=[^&]*" | cut -d= -f2 | tr -cd '0-9')
    
    # Validate zoom levels
    [ -z "$ZMIN" ] && ZMIN=12
    [ -z "$ZMAX" ] && ZMAX=16
    if [ "$ZMIN" -gt "$ZMAX" ]; then TMP=$ZMIN; ZMIN=$ZMAX; ZMAX=$TMP; fi
    [ "$ZMIN" -lt 0 ] && ZMIN=0
    [ "$ZMAX" -gt 18 ] && ZMAX=18
    
    # Write a wrapper script with unique PID to avoid race conditions
    DL_SCRIPT="/tmp/download_tiles_$$.sh"
    cat << 'SCRIPTEOF' > "$DL_SCRIPT"
#!/bin/sh
N="$1"; S="$2"; E="$3"; W="$4"; ZMIN="$5"; ZMAX="$6"
# Basic tile calculation function
lat2tile() {
    lat=$1; zoom=$2
    awk -v lat=$lat -v z=$zoom 'BEGIN{ pi=3.141592653589793; print int((1.0 - log(tan(lat * pi/180.0) + 1.0/cos(lat * pi/180.0))/pi) / 2.0 * (2^z)) }'
}
lon2tile() {
    lon=$1; zoom=$2
    awk -v lon=$lon -v z=$zoom 'BEGIN{ print int((lon + 180.0) / 360.0 * (2^z)) }'
}

for z in $(seq $ZMIN $ZMAX); do
    X_MIN=$(lon2tile $W $z)
    X_MAX=$(lon2tile $E $z)
    Y_MIN=$(lat2tile $N $z)
    Y_MAX=$(lat2tile $S $z)
    
    for x in $(seq $X_MIN $X_MAX); do
        mkdir -p "/mnt/wardriving/tiles/$z/$x"
        for y in $(seq $Y_MIN $Y_MAX); do
            FILE="/mnt/wardriving/tiles/$z/$x/$y.png"
            if [ ! -f "$FILE" ]; then
                wget -q -T 10 -O "$FILE" "https://tile.openstreetmap.org/$z/$x/$y.png" || rm -f "$FILE"
                sleep 0.2
            fi
        done
    done
done
echo "DONE" > /tmp/dl_status.txt
SCRIPTEOF
    chmod +x "$DL_SCRIPT"
    echo "RUNNING" > /tmp/dl_status.txt
    "$DL_SCRIPT" "$N" "$S" "$E" "$W" "$ZMIN" "$ZMAX" >/tmp/dl_log_$$.txt 2>&1 &
    # Self-cleanup after execution
    ( wait; rm -f "$DL_SCRIPT" ) &
    
    echo '{"status": "started"}'

elif [ "$ACTION" = "start" ]; then
    /etc/init.d/wardriving start >/dev/null 2>&1
    echo '{"status": "started"}'
    
elif [ "$ACTION" = "stop" ]; then
    /etc/init.d/wardriving stop >/dev/null 2>&1
    echo '{"status": "stopped"}'

elif [ "$ACTION" = "list_files" ]; then
    echo "["
    FIRST=1
    
    if [ -f /mnt/wardriving/master.hc2200 ]; then
        NAME="master.hc2200"
        SIZE=$(du -h "/mnt/wardriving/master.hc2200" | awk '{print $1}')
        DATE=$(date -r "/mnt/wardriving/master.hc2200" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || echo "Unknown")
        TOTAL_NETS=$(wc -l < /mnt/wardriving/master_essid.txt 2>/dev/null || echo 0)
        NETS=$(head -n 5 /mnt/wardriving/master_essid.txt 2>/dev/null | tr '\n' ',' | sed 's/,$//' | sed 's/\\/\\\\/g' | sed 's/"/\\"/g')
        if [ "$TOTAL_NETS" -gt 5 ]; then NETS="$NETS... (+$(($TOTAL_NETS - 5)))"; fi
        [ -z "$NETS" ] && NETS="No networks / Empty"
        echo "{\"name\": \"$NAME\", \"size\": \"$SIZE\", \"date\": \"$DATE\", \"nets\": \"$NETS\", \"total_nets\": $TOTAL_NETS}"
        FIRST=0
    fi

    for f in $(ls -1r /mnt/wardriving/*.pcapng 2>/dev/null); do
        NAME=$(basename "$f")
        SIZE=$(du -h "$f" | awk '{print $1}')
        DATE=$(date -r "$f" "+%Y-%m-%d %H:%M:%S")
        TXT="${f%.pcapng}.txt"
        TOTAL_NETS=$(wc -l < "$TXT" 2>/dev/null || echo 0)
        NETS=$(head -n 5 "$TXT" 2>/dev/null | tr '\n' ',' | sed 's/,$//' | sed 's/\\/\\\\/g' | sed 's/"/\\"/g')
        if [ "$TOTAL_NETS" -gt 5 ]; then NETS="$NETS... (+$(($TOTAL_NETS - 5)))"; fi
        [ -z "$NETS" ] && NETS="No networks / Empty"
        [ $FIRST -eq 0 ] && echo ","
        echo "{\"name\": \"$NAME\", \"size\": \"$SIZE\", \"date\": \"$DATE\", \"nets\": \"$NETS\", \"total_nets\": $TOTAL_NETS}"
        FIRST=0
    done
    echo "]"
elif [ "$ACTION" = "delete_file" ]; then
    FILE=$(echo "$QUERY_STRING" | grep -o "file=[^&]*" | cut -d= -f2)
    if [ -n "$FILE" ]; then
        # Sanitize: keep only alphanumeric, dot, underscore, dash. Reject if contains /
        SAFE=$(echo "$FILE" | sed -e 's/[^a-zA-Z0-9._-]//g')
        if [ "$SAFE" != "$FILE" ] || echo "$FILE" | grep -q '/'; then
            echo '{"status": "error", "reason": "invalid filename"}'
            exit 0
        fi
        BASENAME=$(basename "$SAFE")
        # Safety: only allow deletion within /mnt/wardriving
        TARGET="/mnt/wardriving/$BASENAME"
        case "$(readlink -f "$TARGET" 2>/dev/null || realpath "$TARGET" 2>/dev/null || echo "$TARGET")" in
            /mnt/wardriving/*)
                rm -f "$TARGET"
                rm -f "/mnt/wardriving/${BASENAME%.pcapng}.txt"
                rm -f "/mnt/wardriving/${BASENAME%.pcapng}.nmea"
                echo '{"status": "deleted"}'
                ;;
            *)
                echo '{"status": "error", "reason": "path traversal blocked"}'
                ;;
        esac
    else
        echo '{"status": "error"}'
    fi
    
elif [ "$ACTION" = "get_hw" ]; then
    LEDS=$(ls -1 /sys/class/leds/ 2>/dev/null | awk 'BEGIN{printf "["} {if (NR>1) printf ","; printf "\"%s\"", $1} END{print "]"}')
    CUR_LED=$(grep "/sys/class/leds/" /etc/init.d/wardriving | head -n 1 | sed -n 's|.*/sys/class/leds/\([^/]*\)/.*|\1|p')
    [ -z "$CUR_LED" ] && CUR_LED="green:wps"
    CUR_BTN="none"
    if grep -q "wardriving_core" /etc/rc.button/wps 2>/dev/null; then CUR_BTN="wps"; fi
