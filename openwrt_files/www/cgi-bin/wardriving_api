#!/bin/sh

resolve_lib_dir() {
    if [ -n "${WARDRIVING_LIB_DIR:-}" ]; then
        echo "$WARDRIVING_LIB_DIR"
    elif [ -d /usr/lib/wardriving ]; then
        echo /usr/lib/wardriving
    elif [ -d ./openwrt_files/usr/lib/wardriving ]; then
        echo ./openwrt_files/usr/lib/wardriving
    else
        echo /usr/lib/wardriving
    fi
}

LIB_DIR=$(resolve_lib_dir)

# shellcheck disable=SC1091 # Runtime path is resolved above for router and local tests.
. "$LIB_DIR/common.sh"
# shellcheck disable=SC1091 # Runtime path is resolved above for router and local tests.
. "$LIB_DIR/db.sh"
# shellcheck disable=SC1091 # Runtime path is resolved above for router and local tests.
. "$LIB_DIR/remote.sh"
# shellcheck disable=SC1091 # Runtime path is resolved above for router and local tests.
. "$LIB_DIR/handlers/status.sh"
# shellcheck disable=SC1091 # Runtime path is resolved above for router and local tests.
. "$LIB_DIR/handlers/captures.sh"
# shellcheck disable=SC1091 # Runtime path is resolved above for router and local tests.
. "$LIB_DIR/handlers/replay.sh"
# shellcheck disable=SC1091 # Runtime path is resolved above for router and local tests.
. "$LIB_DIR/handlers/maps.sh"
# shellcheck disable=SC1091 # Runtime path is resolved above for router and local tests.
. "$LIB_DIR/handlers/settings.sh"

require_auth

case "$ACTION" in
    download_all) handle_download_all ;;
    export_gpx) handle_export_gpx ;;
    export_kml) handle_export_kml ;;
    export_hashcat) handle_export_hashcat ;;
    *)
        emit_json_headers
        case "$ACTION" in
            status) handle_status ;;
            gps_push) handle_gps_push ;;
            upload_potfile) handle_upload_potfile ;;
            pwnagotchi_sync) handle_pwnagotchi_sync ;;
            replay_start) handle_replay_start ;;
            replay_status) handle_replay_status ;;
            replay_seek) handle_replay_seek ;;
            replay_pause) handle_replay_pause ;;
            replay_stop) handle_replay_stop ;;
            replay_report) handle_replay_report ;;
            replay_discovered) handle_replay_discovered ;;
            networks_map) handle_networks_map ;;
            clients_map) handle_clients_map ;;
            cracked_networks) handle_cracked_networks ;;
            upload_tiles) handle_upload_tiles ;;
            save_wigle_token) handle_save_wigle_token ;;
            wigle_upload) handle_wigle_upload ;;
            heatmap_data) handle_heatmap_data ;;
            map_data) handle_map_data ;;
            download_status) handle_download_status ;;
            download_bbox) handle_download_bbox ;;
            start) handle_start ;;
            stop) handle_stop ;;
            list_files) handle_list_files ;;
            delete_file) handle_delete_file ;;
            get_mode) handle_get_mode ;;
            set_mode) handle_set_mode ;;
            get_hw) handle_get_hw ;;
            set_processing) handle_set_processing ;;
            get_processing) handle_get_processing ;;
            set_pcap_retention) handle_set_pcap_retention ;;
            set_hw) handle_set_hw ;;
            pwnagotchi_status) handle_pwnagotchi_status ;;
            scored_networks) handle_scored_networks ;;
            get_targets) handle_get_targets ;;
            add_target) handle_add_target ;;
            remove_target) handle_remove_target ;;
            check_targets) handle_check_targets ;;
            get_exclusions) handle_get_exclusions ;;
            add_exclusion) handle_add_exclusion ;;
            remove_exclusion) handle_remove_exclusion ;;
            history) handle_history ;;
            *) echo '{"error": "unknown action"}' ;;
        esac
        ;;
esac
