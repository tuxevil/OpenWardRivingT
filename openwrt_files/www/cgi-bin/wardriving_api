#!/bin/sh
# ===== TOKEN EXTRACTION & AUTH CHECK =====
ACTION=$(echo "$QUERY_STRING" | grep -o "action=[^&]*" | cut -d= -f2)
TOKEN=$(echo "$QUERY_STRING" | grep -o "token=[^&]*" | cut -d= -f2)

# Actions that mutate state or expose sensitive data
case "$ACTION" in
    start|stop|delete_file|set_hw|set_pcap_retention|save_wigle_token|wigle_upload|upload_tiles|upload_potfile|add_target|remove_target|add_exclusion|remove_exclusion|download_all|download_bbox)
        if [ ! -f /etc/wardriving_api_token ] || [ "$TOKEN" != "$(cat /etc/wardriving_api_token)" ]; then
            echo "Content-Type: application/json"
            echo ""
            echo '{"error": "unauthorized", "reason": "valid token required for this action"}'
            exit 1
        fi
        ;;
esac

# ===== SHARED NMEA PARSER =====
# Usage: parse_nmea_rmc "$GPRMC_LINE"
# Outputs: lat lon speed_kmh date time
parse_nmea_rmc() {
    echo "$1" | awk -F',' '
    $1 ~ /^\$[A-Z]{2}RMC/ && $3 == "A" {
        # Parse lat: DDMM.MMMM
        lat_raw = $4; lat_dir = $5
        lat_deg = substr(lat_raw, 1, 2)
        lat_min = substr(lat_raw, 3)
        lat = lat_deg + (lat_min / 60)
        if (lat_dir == "S") lat = -lat
        
        # Parse lon: DDDMM.MMMM
        lon_raw = $6; lon_dir = $7
        lon_deg = substr(lon_raw, 1, 3)
        lon_min = substr(lon_raw, 4)
        lon = lon_deg + (lon_min / 60)
        if (lon_dir == "W") lon = -lon
        
        speed_kts = $8 + 0
        speed_kmh = speed_kts * 1.852
        
        date_raw = $10
        time_raw = $2
        
        printf "%.6f %.6f %.1f %s %s", lat, lon, speed_kmh, date_raw, time_raw
    }'
}

# ===== END PARSER =====

if [ "$ACTION" = "download_all" ]; then
    echo "Content-Type: application/gzip"
    echo "Content-Disposition: attachment; filename=\"openwardrivingt_captures_$(date +%Y%m%d_%H%M).tar.gz\""
    echo ""
    cd /mnt/wardriving && tar -czf - *.pcapng *.nmea *.hc2200 *.txt 2>/dev/null
    exit 0
fi


if [ "$ACTION" = "export_gpx" ]; then
    echo "Content-Type: application/gpx+xml"
    echo "Content-Disposition: attachment; filename="wardriving_route_$(date +%Y%m%d_%H%M).gpx""
    echo ""
    cat /mnt/wardriving/*.nmea 2>/dev/null | awk '
    BEGIN {
        print "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
        print "<gpx version=\"1.0\">"
        print "  <trk><name>OpenWardRivingT Route</name><trkseg>"
    }
    # NMEA RMC parser — same formula as parse_nmea_rmc()
    /^\$[A-Z]{2}RMC/ {
        if($3 == "A") {
            lat_dec = substr($4,1,2) + (substr($4,3) / 60)
            if($5 == "S") lat_dec = -lat_dec
            lon_dec = substr($6,1,3) + (substr($6,4) / 60)
            if($7 == "W") lon_dec = -lon_dec
            t_raw = $2; d_raw = $10
            ts = "20" substr(d_raw,5,2) "-" substr(d_raw,3,2) "-" substr(d_raw,1,2) "T" substr(t_raw,1,2) ":" substr(t_raw,3,2) ":" substr(t_raw,5,2) "Z"
            printf "    <trkpt lat=\"%.6f\" lon=\"%.6f\">\n      <time>%s</time>\n    </trkpt>\n", lat_dec, lon_dec, ts
        }
    }
    END {
        print "  </trkseg></trk>"
        print "</gpx>"
    }'
    exit 0
fi

if [ "$ACTION" = "export_kml" ]; then
    echo "Content-Type: application/vnd.google-earth.kml+xml"
    echo "Content-Disposition: attachment; filename="wardriving_route_$(date +%Y%m%d_%H%M).kml""
    echo ""
    cat /mnt/wardriving/*.nmea 2>/dev/null | awk '
    BEGIN {
        print "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
        print "<kml xmlns=\"http://www.opengis.net/kml/2.2\">"
        print "  <Document><name>OpenWardRivingT Route</name>"
        print "    <Placemark><name>Route</name><LineString>"
        print "      <tessellate>1</tessellate><coordinates>"
    }
    # NMEA RMC parser — same formula as parse_nmea_rmc()
    /^\$[A-Z]{2}RMC/ {
        if($3 == "A") {
            lat_dec = substr($4,1,2) + (substr($4,3) / 60)
            if($5 == "S") lat_dec = -lat_dec
            lon_dec = substr($6,1,3) + (substr($6,4) / 60)
            if($7 == "W") lon_dec = -lon_dec
            printf "        %.6f,%.6f,0\n", lon_dec, lat_dec
        }
    }
    END {
        print "      </coordinates>"
        print "    </LineString></Placemark>"
        print "  </Document>"
        print "</kml>"
    }'
    exit 0
fi

echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

if [ "$ACTION" = "status" ]; then
    IS_RUNNING=$(pgrep -f "wardriving_core.sh" >/dev/null && echo "true" || echo "false")
    HANDSHAKES=$(wc -l < /mnt/wardriving/master.hc2200 2>/dev/null || echo 0)
    SPACE_USED=$(df -h /mnt/wardriving | awk 'NR==2 {print $3}')
    SPACE_FREE=$(df -h /mnt/wardriving | awk 'NR==2 {print $4}')
    USB_PCT=$(df /mnt/wardriving | awk 'NR==2 {print $5}' | tr -d '%')
    CPU_LOAD=$(uptime | awk -F'load average: ' '{print $2}' | cut -d, -f1 | sed 's/ //g')
    RAM_TOTAL=$(free -m | awk '/^Mem:/{print $2}')
    RAM_FREE=$(free -m | awk '/^Mem:/{print $4}')
    RAM_PCT=0; [ "$RAM_TOTAL" -gt 0 ] && RAM_PCT=$(( 100 * (RAM_TOTAL - RAM_FREE) / RAM_TOTAL ))
    LATEST_NMEA=$(ls -1t /mnt/wardriving/*.nmea 2>/dev/null | head -n 1)
    SATS="0"
    DEAUTHS=$(grep -c -i "deauth" /tmp/wardriving_status.log 2>/dev/null | tr -d "\n" || echo 0)
    FIX="0"
    if [ -f "$LATEST_NMEA" ]; then
        GGA=$(tail -n 20 "$LATEST_NMEA" | grep "^\$G[PN]GGA" | tail -n 1)
        if [ -n "$GGA" ]; then
            FIX=$(echo "$GGA" | cut -d, -f7)
            SATS=$(echo "$GGA" | cut -d, -f8)
        fi
        RMC=$(tail -n 30 "$LATEST_NMEA" | grep "^\$[A-Z]\{2\}RMC" | tail -n 1)
        if [ -n "$RMC" ]; then
            SPEED=$(echo "$RMC" | cut -d, -f8)
        fi
    fi
    GPS_STAT=$(netstat -an | grep 2947 | grep ESTABLISHED >/dev/null && echo "CONNECTED" || echo "WAITING")
    
    CLEAN_LOG=$(tail -n 1000 /tmp/wardriving_status.log 2>/dev/null | awk '/^[ \t]*[0-9]+ [0-9]{2}:[0-9]{2}:[0-9]{2}/ {chan=$1; time=$2; essid=$NF; if(length(essid)>2 && essid!~/:/ && essid !~ /^[0-9a-fA-F]{12}$/ && !seen[essid]++) print "[" time "] [CH " chan "] " essid}' | tail -n 50)
    if [ -z "$CLEAN_LOG" ]; then
        LAST_LOG="Waiting for data or initializing monitor mode..."
    else
        LAST_LOG=$(echo "$CLEAN_LOG" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/$/\\n/g' | tr -d '\n')
    fi
    
    CHANNELS_JSON=$(tail -n 1000 /tmp/wardriving_status.log 2>/dev/null | awk '/^[ \t]*[0-9]+ [0-9]{2}:[0-9]{2}:[0-9]{2}/ {chan=$1; essid=$NF; if(length(essid)>2 && essid!~/:/ && essid !~ /^[0-9a-fA-F]{12}$/) print chan, essid}' | sort -u | awk 'BEGIN{print "["} {if (NR>1) print ","; printf "{\"c\":%s, \"s\":\"%s\"}", $1, $2} END{print "]"}' | tr -d '\n')
    [ -z "$CHANNELS_JSON" ] && CHANNELS_JSON="[]"
    if [ "$CHANNELS_JSON" = "[]]" ]; then CHANNELS_JSON="[]"; fi
    
    cat << JSON
{
    "running": $IS_RUNNING,
    "handshakes": "$HANDSHAKES",
    "space_used": "$SPACE_USED",
    "usb_pct": "$USB_PCT",
    "cpu": "$CPU_LOAD",
    "ram": "$RAM_PCT",
    "sats": "$SATS",
    "speed": "$SPEED",
    "deauths": "$DEAUTHS",
    "fix": "$FIX",
    "space_free": "$SPACE_FREE",
    "gps_status": "$GPS_STAT",
    "logs": "$LAST_LOG",
    "channels_data": $CHANNELS_JSON
}
JSON

elif [ "$ACTION" = "gps_push" ]; then
    NMEA_DATA=$(cat)
    if [ -n "$NMEA_DATA" ]; then
        echo "$NMEA_DATA" | socat - TCP4:127.0.0.1:2947 2>/dev/null
    fi
    echo '{"status": "ok"}'


elif [ "$ACTION" = "upload_potfile" ]; then
    cat > /mnt/wardriving/hashcat.potfile
    echo '{"status": "ok"}'

elif [ "$ACTION" = "cracked_networks" ]; then
    echo "["
    if [ -f /mnt/wardriving/hashcat.potfile ] && [ -f /mnt/wardriving/wardriving.db ]; then
        awk -F'*' '/^WPA\*/ {print $4}' /mnt/wardriving/hashcat.potfile | sed 's/../&:/g; s/:$//' | tr 'a-z' 'A-Z' | sort -u > /tmp/cracked_macs.txt
        
        # Generar SQL para extraer lat, lon y ssid de esas MACs
        if [ -s /tmp/cracked_macs.txt ]; then
            COND=$(awk '{printf "\"%s\",", $1}' /tmp/cracked_macs.txt | sed 's/,$//')
            sqlite3 -separator '|' /mnt/wardriving/wardriving.db "SELECT lat, lon, ssid FROM networks WHERE mac IN ($COND) AND lat IS NOT NULL;" 2>/dev/null | awk -F'|' '
            BEGIN { first=1 }
            {
                if(!first) printf ","
                ssid=$3; gsub(/\\/, "\\\\", ssid); gsub(/"/, "\\"", ssid);
                printf "{\"lat\":%s, \"lon\":%s, \"ssid\":\"%s\"}", $1, $2, ssid
                first=0
            }'
        fi
    fi
    echo "]"
    exit 0

elif [ "$ACTION" = "upload_tiles" ]; then
    cat > /tmp/tiles.tar.gz
    rm -rf /tmp/extract_tiles/
    mkdir -p /mnt/wardriving/tiles/ /tmp/extract_tiles/
    tar -xzf /tmp/tiles.tar.gz -C /tmp/extract_tiles/ 2>/dev/null
    
    Z_PARENT=$(find /tmp/extract_tiles/ -type d -name '[0-9]*' | head -n 1 | awk -F/ '{OFS="/"; NF--; print $0}')
    if [ -n "$Z_PARENT" ] && [ -d "$Z_PARENT" ]; then
        cp -r "$Z_PARENT"/* /mnt/wardriving/tiles/ 2>/dev/null
    else
        cp -r /tmp/extract_tiles/* /mnt/wardriving/tiles/ 2>/dev/null
    fi
    
    rm -rf /tmp/extract_tiles/ /tmp/tiles.tar.gz
    echo '{"status": "ok"}'


elif [ "$ACTION" = "save_wigle_token" ]; then
    if [ "$REQUEST_METHOD" = "POST" ]; then
        cat > /etc/wardriving_wigle_token
        chmod 600 /etc/wardriving_wigle_token
        echo '{"status": "ok"}'
    else
        echo '{"error": "POST required"}'
    fi

elif [ "$ACTION" = "wigle_upload" ]; then
    if [ ! -f "/etc/wardriving_wigle_token" ]; then
        echo '{"success": false, "error": "No WiGLE token configured. Save your API token first."}'
        exit 0
    fi
    if [ ! -f "/mnt/wardriving/wardriving.db" ]; then
        echo '{"success": false, "error": "No database found"}'
        exit 0
    fi
    TOKEN=$(cat /etc/wardriving_wigle_token)
    
    echo "WigleWifi-1.4,appRelease=1.0,model=OpenWardRivingT,release=1.0,device=OpenWrt,display=OpenWrt,board=OpenWrt,brand=OpenWrt" > /tmp/wigle.csv
    echo "MAC,SSID,AuthMode,FirstSeen,Channel,RSSI,CurrentLatitude,CurrentLongitude,AltitudeMeters,AccuracyMeters,Type" >> /tmp/wigle.csv
    sqlite3 -separator ',' /mnt/wardriving/wardriving.db "SELECT mac, ssid, enc, first_seen, channel, rssi, lat, lon, 0, 10, 'WIFI' FROM networks WHERE lat IS NOT NULL AND lat != 'NULL';" >> /tmp/wigle.csv
    
    RES=$(curl -s -m 30 -X POST "https://api.wigle.net/api/v2/network/upload" -H "Authorization: Basic $TOKEN" -H "Accept: application/json" -F "file=@/tmp/wigle.csv")
    rm -f /tmp/wigle.csv
    
    if echo "$RES" | grep -q '"success":true'; then
        echo '{"success": true}'
    else
        ERR=$(echo "$RES" | tr -d '\n' | sed 's/"/\\"/g')
        echo "{\"success\": false, \"error\": \"WiGLE rejected: $ERR\"}"
    fi
    exit 0


elif [ "$ACTION" = "heatmap_data" ]; then
    if [ -f /mnt/wardriving/wardriving.db ]; then
        sqlite3 -separator ',' /mnt/wardriving/wardriving.db "SELECT lat, lon, rssi FROM networks WHERE lat IS NOT NULL;" 2>/dev/null | awk -F',' '
        BEGIN { printf "[" }
        {
            if (NR>1) printf ",";
            intensity = ($3 + 100) / 60;
            if (intensity < 0) intensity = 0.1;
            if (intensity > 1) intensity = 1.0;
            printf "[%s, %s, %.2f]", $1, $2, intensity
        }
        END { print "]" }'
    else
        echo "[]"
    fi

elif [ "$ACTION" = "map_data" ]; then
    LATEST_NMEA=$(ls -1t /mnt/wardriving/*.nmea 2>/dev/null | head -n 1)
    if [ -f "$LATEST_NMEA" ]; then
        NMEA_B64=$(tail -n 20 "$LATEST_NMEA" | base64 | tr -d '\n')
        echo "{\"nmea_b64\": \"$NMEA_B64\"}"
    else
        echo '{"nmea_b64": ""}'
    fi


elif [ "$ACTION" = "download_status" ]; then
    if [ -f /tmp/dl_status.txt ]; then
        STAT=$(cat /tmp/dl_status.txt)
        echo "{\"status\": \"$STAT\"}"
    else
        echo '{"status": "NONE"}'
    fi

elif [ "$ACTION" = "download_bbox" ]; then
    N=$(echo "$QUERY_STRING" | grep -o "n=[^&]*" | cut -d= -f2 | tr -cd '0-9.-')
    S=$(echo "$QUERY_STRING" | grep -o "s=[^&]*" | cut -d= -f2 | tr -cd '0-9.-')
    E=$(echo "$QUERY_STRING" | grep -o "e=[^&]*" | cut -d= -f2 | tr -cd '0-9.-')
    W=$(echo "$QUERY_STRING" | grep -o "w=[^&]*" | cut -d= -f2 | tr -cd '0-9.-')
    ZMIN=$(echo "$QUERY_STRING" | grep -o "z1=[^&]*" | cut -d= -f2 | tr -cd '0-9')
    ZMAX=$(echo "$QUERY_STRING" | grep -o "z2=[^&]*" | cut -d= -f2 | tr -cd '0-9')
    
    # Write a wrapper script with unique PID to avoid race conditions
    DL_SCRIPT="/tmp/download_tiles_$$.sh"
    cat << 'SCRIPTEOF' > "$DL_SCRIPT"
#!/bin/sh
N="$1"; S="$2"; E="$3"; W="$4"; ZMIN="$5"; ZMAX="$6"
# Basic tile calculation function
lat2tile() {
    lat=$1; zoom=$2
    awk -v lat=$lat -v z=$zoom 'BEGIN{ pi=3.141592653589793; print int((1.0 - log(tan(lat * pi/180.0) + 1.0/cos(lat * pi/180.0))/pi) / 2.0 * (2^z)) }'
}
lon2tile() {
    lon=$1; zoom=$2
    awk -v lon=$lon -v z=$zoom 'BEGIN{ print int((lon + 180.0) / 360.0 * (2^z)) }'
}

for z in $(seq $ZMIN $ZMAX); do
    X_MIN=$(lon2tile $W $z)
    X_MAX=$(lon2tile $E $z)
    Y_MIN=$(lat2tile $N $z)
    Y_MAX=$(lat2tile $S $z)
    
    for x in $(seq $X_MIN $X_MAX); do
        mkdir -p "/mnt/wardriving/tiles/$z/$x"
        for y in $(seq $Y_MIN $Y_MAX); do
            FILE="/mnt/wardriving/tiles/$z/$x/$y.png"
            if [ ! -f "$FILE" ]; then
                wget -q -T 10 -O "$FILE" "https://tile.openstreetmap.org/$z/$x/$y.png" || rm -f "$FILE"
                sleep 0.2
            fi
        done
    done
done
echo "DONE" > /tmp/dl_status.txt
SCRIPTEOF
    chmod +x "$DL_SCRIPT"
    echo "RUNNING" > /tmp/dl_status.txt
    "$DL_SCRIPT" "$N" "$S" "$E" "$W" "$ZMIN" "$ZMAX" >/tmp/dl_log_$$.txt 2>&1 &
    # Self-cleanup after execution
    ( wait; rm -f "$DL_SCRIPT" ) &
    
    echo '{"status": "started"}'

elif [ "$ACTION" = "start" ]; then
    /etc/init.d/wardriving start >/dev/null 2>&1
    echo '{"status": "started"}'
    
elif [ "$ACTION" = "stop" ]; then
    /etc/init.d/wardriving stop >/dev/null 2>&1
    echo '{"status": "stopped"}'

elif [ "$ACTION" = "list_files" ]; then
    echo "["
    FIRST=1
    
    if [ -f /mnt/wardriving/master.hc2200 ]; then
        NAME="master.hc2200"
        SIZE=$(du -h "/mnt/wardriving/master.hc2200" | awk '{print $1}')
        DATE=$(date -r "/mnt/wardriving/master.hc2200" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || echo "Unknown")
        TOTAL_NETS=$(wc -l < /mnt/wardriving/master_essid.txt 2>/dev/null || echo 0)
        NETS=$(head -n 5 /mnt/wardriving/master_essid.txt 2>/dev/null | tr '\n' ',' | sed 's/,$//' | sed 's/\\/\\\\/g' | sed 's/"/\\"/g')
        if [ "$TOTAL_NETS" -gt 5 ]; then NETS="$NETS... (+$(($TOTAL_NETS - 5)))"; fi
        [ -z "$NETS" ] && NETS="No networks / Empty"
        echo "{\"name\": \"$NAME\", \"size\": \"$SIZE\", \"date\": \"$DATE\", \"nets\": \"$NETS\", \"total_nets\": $TOTAL_NETS}"
        FIRST=0
    fi

    for f in $(ls -1r /mnt/wardriving/*.pcapng 2>/dev/null); do
        NAME=$(basename "$f")
        SIZE=$(du -h "$f" | awk '{print $1}')
        DATE=$(date -r "$f" "+%Y-%m-%d %H:%M:%S")
        TXT="${f%.pcapng}.txt"
        TOTAL_NETS=$(wc -l < "$TXT" 2>/dev/null || echo 0)
        NETS=$(head -n 5 "$TXT" 2>/dev/null | tr '\n' ',' | sed 's/,$//' | sed 's/\\/\\\\/g' | sed 's/"/\\"/g')
        if [ "$TOTAL_NETS" -gt 5 ]; then NETS="$NETS... (+$(($TOTAL_NETS - 5)))"; fi
        [ -z "$NETS" ] && NETS="No networks / Empty"
        [ $FIRST -eq 0 ] && echo ","
        echo "{\"name\": \"$NAME\", \"size\": \"$SIZE\", \"date\": \"$DATE\", \"nets\": \"$NETS\", \"total_nets\": $TOTAL_NETS}"
        FIRST=0
    done
    echo "]"
elif [ "$ACTION" = "delete_file" ]; then
    FILE=$(echo "$QUERY_STRING" | grep -o "file=[^&]*" | cut -d= -f2)
    if [ -n "$FILE" ]; then
        # Sanitize: keep only alphanumeric, dot, underscore, dash. Reject if contains /
        SAFE=$(echo "$FILE" | sed -e 's/[^a-zA-Z0-9._-]//g')
        if [ "$SAFE" != "$FILE" ] || echo "$FILE" | grep -q '/'; then
            echo '{"status": "error", "reason": "invalid filename"}'
            exit 0
        fi
        BASENAME=$(basename "$SAFE")
        # Safety: only allow deletion within /mnt/wardriving
        TARGET="/mnt/wardriving/$BASENAME"
        case "$(readlink -f "$TARGET" 2>/dev/null || realpath "$TARGET" 2>/dev/null || echo "$TARGET")" in
            /mnt/wardriving/*)
                rm -f "$TARGET"
                rm -f "/mnt/wardriving/${BASENAME%.pcapng}.txt"
                rm -f "/mnt/wardriving/${BASENAME%.pcapng}.nmea"
                echo '{"status": "deleted"}'
                ;;
            *)
                echo '{"status": "error", "reason": "path traversal blocked"}'
                ;;
        esac
    else
        echo '{"status": "error"}'
    fi
    
elif [ "$ACTION" = "get_hw" ]; then
    LEDS=$(ls -1 /sys/class/leds/ 2>/dev/null | awk 'BEGIN{printf "["} {if (NR>1) printf ","; printf "\"%s\"", $1} END{print "]"}')
    CUR_LED=$(grep "/sys/class/leds/" /etc/init.d/wardriving | head -n 1 | sed -n 's|.*/sys/class/leds/\([^/]*\)/.*|\1|p')
    [ -z "$CUR_LED" ] && CUR_LED="green:wps"
    CUR_BTN="none"
    if grep -q "wardriving_core" /etc/rc.button/wps 2>/dev/null; then CUR_BTN="wps"; fi
    if grep -q "wardriving_core" /etc/rc.button/rfkill 2>/dev/null; then CUR_BTN="wifi"; fi
    
    CUR_MODE="active"
    if [ -f /etc/wardriving_mode.txt ]; then CUR_MODE=$(cat /etc/wardriving_mode.txt); fi
    KEEP="false"; [ -f /etc/wardriving_keep_pcap.txt ] && KEEP="true"
    echo "{\"leds\": $LEDS, \"current_led\": \"$CUR_LED\", \"current_button\": \"$CUR_BTN\", \"mode\": \"$CUR_MODE\", \"keep_pcap\": \"$KEEP\"}"



elif [ "$ACTION" = "set_pcap_retention" ]; then
    KEEP=$(echo "$QUERY_STRING" | grep -o "keep=[^&]*" | cut -d= -f2)
    if [ "$KEEP" = "true" ]; then touch /etc/wardriving_keep_pcap.txt; else rm -f /etc/wardriving_keep_pcap.txt; fi
    echo '{"status": "saved"}'

elif [ "$ACTION" = "set_hw" ]; then
    LED=$(echo "$QUERY_STRING" | grep -o "led=[^&]*" | cut -d= -f2 | sed 's/%3A/:/g')
    BTN=$(echo "$QUERY_STRING" | grep -o "btn=[^&]*" | cut -d= -f2)
    MODE=$(echo "$QUERY_STRING" | grep -o "mode=[^&]*" | cut -d= -f2)
    echo "$MODE" > /etc/wardriving_mode.txt
    
    # Atomic sed: write to temp, then mv
    TMP_INIT=$(mktemp /tmp/wardriving_init_XXXXXX)
    sed "s|/sys/class/leds/[^/]*/|/sys/class/leds/$LED/|g" /etc/init.d/wardriving > "$TMP_INIT" && mv "$TMP_INIT" /etc/init.d/wardriving
    rm -f "$TMP_INIT"
    
    # Always restore defaults first (atomic via temp + mv)
    TMP_WPS=$(mktemp /tmp/wardriving_wps_XXXXXX)
    cat << 'EOF_RESTORE' > "$TMP_WPS"
#!/bin/sh
[ "$ACTION" = "pressed" ] && exit 5
for script in /etc/rc.wps/*; do
	[ -x "$script" ] || continue
	"$script" && break
done
EOF_RESTORE
    mv "$TMP_WPS" /etc/rc.button/wps
    rm -f "$TMP_WPS"

    TMP_RFKILL=$(mktemp /tmp/wardriving_rfkill_XXXXXX)
    cat << 'EOF_RESTORE' > "$TMP_RFKILL"
#!/bin/sh
[ "${ACTION}" = "released" -o -n "${TYPE}" ] || exit 0
. /lib/functions.sh
rfkill_state=0
wifi_rfkill_set() { uci set wireless.$1.disabled=$rfkill_state; }
wifi_rfkill_check() {
	local disabled; config_get disabled $1 disabled
	[ "$disabled" = "1" ] || rfkill_state=1
}
config_load wireless
case "${TYPE}" in
"switch") [ "${ACTION}" = "released" ] && rfkill_state=1 ;;
*) config_foreach wifi_rfkill_check wifi-device ;;
esac
config_foreach wifi_rfkill_set wifi-device
uci commit wireless; wifi up
return 0
EOF_RESTORE
    mv "$TMP_RFKILL" /etc/rc.button/rfkill
    rm -f "$TMP_RFKILL"
    
    if [ "$BTN" = "wps" ]; then
        TMP_BTN=$(mktemp /tmp/wardriving_btn_XXXXXX)
        cat << 'EOF2' > "$TMP_BTN"
#!/bin/sh
[ "${ACTION}" = "released" ] || exit 0
if pgrep -f "wardriving_core.sh" >/dev/null; then
    /etc/init.d/wardriving stop
else
    /etc/init.d/wardriving start
fi
EOF2
        chmod +x "$TMP_BTN"
        mv "$TMP_BTN" /etc/rc.button/wps
        rm -f "$TMP_BTN"
    elif [ "$BTN" = "wifi" ]; then
        TMP_BTN=$(mktemp /tmp/wardriving_btn_XXXXXX)
        cat << 'EOF2' > "$TMP_BTN"
#!/bin/sh
[ "${ACTION}" = "released" ] || exit 0
if pgrep -f "wardriving_core.sh" >/dev/null; then
    /etc/init.d/wardriving stop
else
    /etc/init.d/wardriving start
fi
EOF2
        chmod +x "$TMP_BTN"
        mv "$TMP_BTN" /etc/rc.button/rfkill
        rm -f "$TMP_BTN"
    fi
    echo '{"status": "saved"}'


elif [ "$ACTION" = "scored_networks" ]; then
    if [ -f /mnt/wardriving/wardriving.db ]; then
        # Pre-compute handshake MACs to avoid system() calls in awk loop
        HS_MACS=$(grep -oP '\*\K[0-9a-fA-F]{12}' /mnt/wardriving/master.hc2200 2>/dev/null | tr '[:upper:]' '[:lower:]' | sort -u | paste -sd '|' -)
        sqlite3 -separator '|' /mnt/wardriving/wardriving.db "SELECT mac, ssid, enc, rssi FROM networks WHERE last_seen >= datetime('now', '-5 minutes') ORDER BY rssi DESC LIMIT 30;" 2>/dev/null | awk -F'|' -v hs_macs="$HS_MACS" '
        BEGIN { printf "[" }
        {
            mac=$1; ssid=$2; enc=$3; rssi=$4;
            # Proper JSON escaping in awk
            gsub(/\\/, "\\\\", ssid);
            gsub(/"/, "\\"", ssid);
            gsub(/\x08/, "\\b", ssid);
            gsub(/\x0c/, "\\f", ssid);
            gsub(/\n/, "\\n", ssid);
            gsub(/\r/, "\\r", ssid);
            gsub(/\t/, "\\t", ssid);
            # Remove any other non-printable characters
            gsub(/[^\x20-\x7E]/, "", ssid);
            mac_hex = tolower(mac); gsub(/:/, "", mac_hex);
            
            has_hs = "false"
            if (hs_macs ~ mac_hex) has_hs = "true"
            
            if(NR>1) printf ",";
            printf "{\"mac\":\"%s\",\"ssid\":\"%s\",\"enc\":\"%s\",\"rssi\":%s,\"has_hs\":%s}", mac, ssid, enc, rssi, has_hs
        }
        END { print "]" }'
    else
        echo "[]"
    fi

elif [ "$ACTION" = "get_targets" ]; then
    touch /etc/wardriving_targets.txt
    awk 'BEGIN {print "["} {if (NR>1) print ","; printf "\"%s\"", $0} END {print "\n]"}' /etc/wardriving_targets.txt

elif [ "$ACTION" = "add_target" ]; then
    MAC=$(echo "$QUERY_STRING" | awk -F'mac=' '{print $2}' | cut -d'&' -f1 | sed 's/%3A/:/g' | sed 's/%3a/:/g')
    if [ -n "$MAC" ]; then
        touch /etc/wardriving_targets.txt
        if ! grep -Fxq "$MAC" /etc/wardriving_targets.txt; then
            echo "$MAC" >> /etc/wardriving_targets.txt
        fi
        echo '{"status":"added"}'
    else
        echo '{"status":"error"}'
    fi

elif [ "$ACTION" = "remove_target" ]; then
    MAC=$(echo "$QUERY_STRING" | awk -F'mac=' '{print $2}' | cut -d'&' -f1 | sed 's/%3A/:/g' | sed 's/%3a/:/g')
    if [ -n "$MAC" ]; then
        touch /etc/wardriving_targets.txt
        awk -v m="$MAC" '$0!=m' /etc/wardriving_targets.txt > /tmp/tmp_tm && mv /tmp/tmp_tm /etc/wardriving_targets.txt
        echo '{"status":"removed"}'
    else
        echo '{"status":"error"}'
    fi

elif [ "$ACTION" = "check_targets" ]; then
    if [ -f /mnt/wardriving/wardriving.db ] && [ -s /etc/wardriving_targets.txt ]; then
        # Build SQL condition: mac LIKE 'PREFIX%' OR ...
        COND=$(awk '{printf "mac LIKE '%s%%' OR ", $1}' /etc/wardriving_targets.txt | sed 's/ OR $//')
        sqlite3 -json /mnt/wardriving/wardriving.db "SELECT mac, ssid FROM networks WHERE ($COND) AND last_seen >= datetime('now', '-2 minutes');" 2>/dev/null || echo "[]"
    else
        echo "[]"
    fi

elif [ "$ACTION" = "get_exclusions" ]; then
    touch /etc/wardriving_excluded.txt /etc/wardriving_removed.txt
    cat /mnt/wardriving/*.txt 2>/dev/null | sort -u | awk 'FILENAME == ARGV[1] {rem[$0]; next} {if (!($0 in rem)) print $0}' /etc/wardriving_removed.txt - > /tmp/new_excl
    cat /etc/wardriving_excluded.txt >> /tmp/new_excl
    sort -u /tmp/new_excl > /etc/wardriving_excluded.txt
    rm -f /tmp/new_excl

    awk 'BEGIN {print "["} {if (NR>1) print ","; gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); printf "\"%s\"", $0} END {print "\n]"}' /etc/wardriving_excluded.txt

elif [ "$ACTION" = "add_exclusion" ]; then
    RAW_SSID=$(echo "$QUERY_STRING" | awk -F'ssid=' '{print $2}' | cut -d'&' -f1)
    SSID=$(echo "$RAW_SSID" | awk 'BEGIN{c2x["0"]="0";c2x["1"]="1";c2x["2"]="2";c2x["3"]="3";c2x["4"]="4";c2x["5"]="5";c2x["6"]="6";c2x["7"]="7";c2x["8"]="8";c2x["9"]="9";c2x["A"]="10";c2x["B"]="11";c2x["C"]="12";c2x["D"]="13";c2x["E"]="14";c2x["F"]="15";c2x["a"]="10";c2x["b"]="11";c2x["c"]="12";c2x["d"]="13";c2x["e"]="14";c2x["f"]="15"} {gsub(/\+/," "); res=""; i=1; while(i<=length($0)){c=substr($0,i,1); if(c=="%"){hex=substr($0,i+1,2); val=c2x[substr(hex,1,1)]*16+c2x[substr(hex,2,1)]; res=res sprintf("%c",val); i+=2} else{res=res c} i++} print res}')
    if [ -n "$SSID" ]; then
        touch /etc/wardriving_excluded.txt /etc/wardriving_removed.txt
        awk -v s="$SSID" '$0!=s' /etc/wardriving_removed.txt > /tmp/tmp_rm && mv /tmp/tmp_rm /etc/wardriving_removed.txt
        if ! grep -Fxq "$SSID" /etc/wardriving_excluded.txt; then
            echo "$SSID" >> /etc/wardriving_excluded.txt
        fi
        echo '{"status":"added"}'
    else
        echo '{"status":"error"}'
    fi

elif [ "$ACTION" = "remove_exclusion" ]; then
    RAW_SSID=$(echo "$QUERY_STRING" | awk -F'ssid=' '{print $2}' | cut -d'&' -f1)
    SSID=$(echo "$RAW_SSID" | awk 'BEGIN{c2x["0"]="0";c2x["1"]="1";c2x["2"]="2";c2x["3"]="3";c2x["4"]="4";c2x["5"]="5";c2x["6"]="6";c2x["7"]="7";c2x["8"]="8";c2x["9"]="9";c2x["A"]="10";c2x["B"]="11";c2x["C"]="12";c2x["D"]="13";c2x["E"]="14";c2x["F"]="15";c2x["a"]="10";c2x["b"]="11";c2x["c"]="12";c2x["d"]="13";c2x["e"]="14";c2x["f"]="15"} {gsub(/\+/," "); res=""; i=1; while(i<=length($0)){c=substr($0,i,1); if(c=="%"){hex=substr($0,i+1,2); val=c2x[substr(hex,1,1)]*16+c2x[substr(hex,2,1)]; res=res sprintf("%c",val); i+=2} else{res=res c} i++} print res}')
    if [ -n "$SSID" ]; then
        touch /etc/wardriving_excluded.txt /etc/wardriving_removed.txt
        awk -v s="$SSID" '$0!=s' /etc/wardriving_excluded.txt > /tmp/tmp_rm && mv /tmp/tmp_rm /etc/wardriving_excluded.txt
        if ! grep -Fxq "$SSID" /etc/wardriving_removed.txt; then
            echo "$SSID" >> /etc/wardriving_removed.txt
        fi
        echo '{"status":"removed"}'
    else
        echo '{"status":"error"}'
    fi


elif [ "$ACTION" = "history" ]; then
    if [ ! -f /mnt/wardriving/wardriving.db ]; then
        echo '{"total":0, "wpa3":0, "hs":0, "days":0, "sessions":[]}'
        exit 0
    fi
    TOTAL=$(sqlite3 /mnt/wardriving/wardriving.db "SELECT COUNT(*) FROM networks;" 2>/dev/null)
    [ -z "$TOTAL" ] && TOTAL=0
    WPA3=$(sqlite3 /mnt/wardriving/wardriving.db "SELECT COUNT(*) FROM networks WHERE enc LIKE '%SAE%';" 2>/dev/null)
    [ -z "$WPA3" ] && WPA3=0
    HS=$(wc -l < /mnt/wardriving/master.hc2200 2>/dev/null || echo 0)
    DAYS=$(sqlite3 /mnt/wardriving/wardriving.db "SELECT COUNT(DISTINCT date(last_seen)) FROM networks;" 2>/dev/null)
    [ -z "$DAYS" ] && DAYS=0
    
    echo "{\"total\":$TOTAL, \"wpa3\":$WPA3, \"hs\":$HS, \"days\":$DAYS, \"sessions\":["
    sqlite3 -separator '|' /mnt/wardriving/wardriving.db "SELECT date(last_seen), COUNT(*) FROM networks GROUP BY date(last_seen) ORDER BY date(last_seen) DESC LIMIT 7;" 2>/dev/null | awk -F'|' '
    BEGIN { first=1 }
    {
        if(!first) printf ","
        printf "{\"date\":\"%s\", \"count\":%s, \"hs_count\":\"N/A\"}", $1, $2
        first=0
    }
    END { print "]" }'
    echo "}"
    exit 0

else
    echo '{"error": "unknown action"}'
fi
